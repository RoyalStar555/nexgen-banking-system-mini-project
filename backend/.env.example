# Backend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in the .env file
#   3. The .env file is git-ignored — NEVER commit it
#   4. Inject these values into application.properties via ${VAR_NAME} syntax
#      or use Spring Profiles (application-dev.properties, application-prod.properties)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_ENV=development          # development | staging | production

# ── CORS ─────────────────────────────────────────────────────────────────────
# DEV: wildcard — allows all origins for local testing
# PROD: restrict to your GitHub Pages or cloud frontend URL
CORS_ALLOWED_ORIGINS=*
# PROD example: CORS_ALLOWED_ORIGINS=https://yourusername.github.io

# ── Persistence (in-memory by default; swap for DB in production) ─────────────
# Set to "true" to enable JSON flat-file persistence (future feature)
PERSISTENCE_ENABLED=false
PERSISTENCE_FILE_PATH=./data/bank_state.json

# ── Security (for future JWT integration) ────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_256_BIT_SECRET_IN_PRODUCTION
JWT_EXPIRY_MS=86400000          # 24 hours in milliseconds

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG                 # DEBUG | INFO | WARN | ERROR
LOG_FILE_PATH=./logs/nexgen-banking.log

# ── Account Seeding (demo data) ──────────────────────────────────────────────
SEED_ENABLED=true
SEED_SAVINGS_BALANCE=150000.00
SEED_CURRENT_BALANCE=500000.00

# ── Rate Limiting (for future implementation) ─────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Cloud Deployment (Render / Railway) ──────────────────────────────────────
# Used when deploying backend to a cloud PaaS
# RENDER_EXTERNAL_URL=https://nexgen-banking-api.onrender.com
# RAILWAY_STATIC_URL=https://nexgen-banking-api.up.railway.app
