# ============================================================
#  NexGen Banking — Root .gitignore
#  Covers: Java/Maven, Node.js, IDE artifacts, secrets
# ============================================================

# ─── Java / Maven ────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# ─── Spring Boot ─────────────────────────────────────────────
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-prod.properties

# ─── Node / npm (if frontend build tools are added later) ────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.cache/

# ─── Environment / Secrets (NEVER commit real .env files) ────
.env
.env.local
.env.development
.env.staging
.env.production
backend/.env
frontend/.env
*.pem
*.p12
*.jks
secrets/

# ─── IDE & OS Artifacts ──────────────────────────────────────
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
*.code-workspace

# Eclipse / STS
.eclipse/
.settings/
.classpath
.project

# NetBeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
spring.log

# ─── Test & Coverage Reports ─────────────────────────────────
/report/
coverage/
*.exec
notebooklm_report_bundle/
NEXGEN_BANKING_FULL_CODEBASE.md
