# Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values.
#   3. For Vanilla JS (no build tool), these values are read by config.js
#      which performs runtime environment detection via window.location.hostname
#   4. If using a build tool (Vite/Webpack in the future), prefix with VITE_
# ─────────────────────────────────────────────────────────────────────────────

# ── API Target ───────────────────────────────────────────────────────────────
# DEV: Points to local Spring Boot server
VITE_API_BASE_URL_DEV=http://localhost:8080/api

# PROD: Points to your deployed cloud backend
# Replace with your actual Render / Railway URL after deploying the backend
VITE_API_BASE_URL_PROD=https://nexgen-banking-api.onrender.com/api

# ── App Meta ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=NexGen Banking
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development        # development | staging | production

# ── Feature Flags ────────────────────────────────────────────────────────────
VITE_FEATURE_VAULT=true         # Show Goal Vault Manager screen
VITE_FEATURE_PASSBOOK_CSV=true  # Show CSV download on Passbook screen
VITE_FEATURE_DARK_MODE=true     # Enable dark/light mode toggle

# ── Pagination ───────────────────────────────────────────────────────────────
VITE_PAGE_SIZE=10               # Number of transactions per page in Passbook

# ── UX ───────────────────────────────────────────────────────────────────────
VITE_TOAST_DURATION_MS=4000     # How long toast notifications stay visible
VITE_SKELETON_DELAY_MS=300      # Minimum time skeleton loaders are shown

# ── GitHub Pages Deployment ───────────────────────────────────────────────────
# Your GitHub Pages URL (set this before deploying frontend)
# VITE_GITHUB_PAGES_URL=https://yourusername.github.io/nexgen-banking

# ── Analytics (future) ────────────────────────────────────────────────────────
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
